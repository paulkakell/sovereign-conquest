# Copy this file to .env before using docker compose.
APP_ENV=development

# Compose pulls the combined API and web image from GHCR. For reproducible
# deployments, replace :main with an immutable version tag or image digest.
SC_IMAGE=ghcr.io/paulkakell/sovereign-conquest:main
SC_PULL_POLICY=always
# Root Compose needs two different host ports. The tailored bind profile uses WEB_PORT only.
WEB_PORT=3000
API_PORT=8080

# These values are reconciled on every db container startup. Keep docker/db/
# beside docker-compose.yml. Recreate db and api after editing credentials.
# Single-quote values containing $ in .env to prevent Compose interpolation.
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_DB=sovereign_conquest
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_SECRET=replace-with-at-least-32-random-characters
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-at-least-16-random-characters
UNIVERSE_SEED=2002
UNIVERSE_SECTORS=200
TURN_REGEN_SECONDS=120
PORT_TICK_SECONDS=60
PLANET_TICK_SECONDS=60
EVENT_TICK_SECONDS=60
PROTECTORATE_TICK_SECONDS=60
