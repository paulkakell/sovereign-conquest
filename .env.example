# Copy this file to .env before using docker compose. Fill the three required
# blank secrets below; Compose refuses to start until they are set.
# This profile uses local PostgreSQL without TLS. APP_ENV=production requires
# a Compose override configuring PostgreSQL TLS and a matching DATABASE_URL.
APP_ENV=development
# Enable only behind a controlled proxy that replaces client forwarding headers.
TRUST_PROXY_HEADERS=false

# Combined API/UI release image. Use this tag after its release gates pass,
# or set a verified @sha256 digest for an immutable deployment.
SC_IMAGE=ghcr.io/paulkakell/sovereign-conquest:01.06.09
SC_PULL_POLICY=always
# Both root-profile ports reach the same container. Use different free host
# ports (1-65535); 127.0.0.1 bindings accept connections only on the Docker host.
# The standalone bind profile uses WEB_PORT only (5000 when unset). This shared
# example explicitly sets 3000; change WEB_PORT to 5000 for that deployment.
WEB_PORT=3000
API_PORT=8080

# Reconciled on every db startup. Keep docker/db/ beside docker-compose.yml.
# Recreate db and api after editing credentials. No URL encoding is required.
# Single-quote values containing $ in .env to prevent Compose interpolation.
# Generate independent random secrets, for example: openssl rand -hex 32
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=
POSTGRES_DB=sovereign_conquest
# Use at least 32 random characters for JWT_SECRET and ADMIN_SECRET.
JWT_SECRET=
# Optional season-reset key; empty disables the HTTP soft-wipe endpoint.
ADMIN_SECRET=
INITIAL_ADMIN_USERNAME=admin
# Use 16-72 ASCII characters; bootstraps new admins, not a password rotation.
INITIAL_ADMIN_PASSWORD=

# Creation-time settings do not rebuild an existing universe.
UNIVERSE_SEED=2002
# Supported input: 2-1000000; generation rounds values below 20 up to 20.
UNIVERSE_SECTORS=200
# Minimum 10 seconds. Tick intervals <=0 disable their job; positive values
# below 5 seconds (port/planet) or 10 (event/protectorate) are rounded up.
TURN_REGEN_SECONDS=120
PORT_TICK_SECONDS=60
PLANET_TICK_SECONDS=60
EVENT_TICK_SECONDS=60
PROTECTORATE_TICK_SECONDS=60
